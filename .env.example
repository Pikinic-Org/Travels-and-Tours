# Base URL of the pikinic-site backend — the source of truth for blog
# posts, flight offers, and travel packages, managed from its admin
# dashboard. Point this at pikinic-site's local dev server while
# developing, and at its deployed URL (e.g. https://pikinic.ng) once
# pikinic-site is live in production.
PIKINIC_API_URL=http://localhost:3000

# Shared secret required on flight search/pricing and payment requests to
# pikinic-site (the x-flights-proxy-secret header). Must exactly match the
# FLIGHTS_PROXY_SECRET value set in pikinic-site's own .env.local.
FLIGHTS_PROXY_SECRET=
